[Unit]
Description=Whoosh reserved-button mouse gesture proxy
After=dbus.service systemd-udevd.service
Requires=dbus.socket
ConditionPathExists=/dev/uinput

[Service]
Type=simple
ExecStart=/usr/local/libexec/whoosh-mouse-proxy.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
