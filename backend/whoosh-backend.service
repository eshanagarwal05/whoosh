[Unit]
Description=Whoosh touchpad gesture backend
After=dbus.service systemd-udevd.service
Requires=dbus.socket
ConditionPathExists=/usr/bin/libinput

[Service]
Type=simple
ExecStart=/usr/local/libexec/whoosh-backend.py --quiet
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
