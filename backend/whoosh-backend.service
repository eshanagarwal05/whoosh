[Unit]
Description=Whoosh touchpad proxy and gesture backend
After=dbus.service systemd-udevd.service
Requires=dbus.socket
ConditionPathExists=/usr/bin/libinput
ConditionPathExists=/dev/uinput

[Service]
Type=simple
ExecStart=/usr/local/libexec/whoosh-input-proxy.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
